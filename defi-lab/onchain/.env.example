# RPC da Sepolia. O publico funciona, mas com 40 alunos simultaneos
# vale um endpoint dedicado (Alchemy/Infura free tier).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chave da carteira do PROFESSOR. Use uma carteira nova, exclusiva da aula,
# que nunca tocou mainnet. Nao commite este arquivo.
DEPLOYER_PRIVATE_KEY=

# Para verificar os contratos no Etherscan (os alunos vao ler o codigo).
ETHERSCAN_API_KEY=

# Opcionais do deploy/abastecimento
GAS_FAUCET_SEED=0.5
GAS_POR_ALUNO=0.02
CSR_POR_ALUNO=5000
BRLX_POR_ALUNO=10000
RESERVA_FAUCET=0.3
